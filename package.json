{
  "name": "ms-transferencias",
  "version": "1.0.0",
  "description": "Microservicio bancario de consulta de saldos y transferencias (Laboratorio 6 - CI, SAST y SCA)",
  "main": "src/server.js",
  "type": "commonjs",
  "private": true,
  "files": [
    "src/"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.js",
    "lint": "eslint . --max-warnings 0",
    "test": "jest --coverage",
    "audit": "npm audit --audit-level=high"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "cobertura",
      "json-summary"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "license": "UNLICENSED",
  "dependencies": {
    "express": "5.3.0",
    "helmet": "8.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "eslint-plugin-security": "4.2.0",
    "globals": "17.13.0",
    "jest": "30.5.2",
    "supertest": "7.3.1"
  }
}
